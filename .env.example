# ── Database ──────────────────────────────────────────────────────────────────
──────────────────────────────────────────────────────────────────
DB_USER=aidoc
DB_PASSWORD=changeme
DB_NAME=aidoc
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── OAuth — Google ────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── LLM (Phase 2+) ───────────────────────────────────────────────────────────
# LLM — any OpenAI-compatible API. Free options for demos:
#   Groq (free tier, fast):  LLM_BASE_URL=https://api.groq.com/openai/v1
#                            LLM_MODEL=openai/gpt-oss-120b
#   Google AI Studio (free): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                            LLM_MODEL=gemini-2.0-flash
#   Ollama (local, no key):  LLM_BASE_URL=http://host.docker.internal:11434/v1
#                            LLM_MODEL=llama3.1  LLM_API_KEY=ollama
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ── LangSmith (Phase 5) ───────────────────────────────────────────────────────
# Create a free account at smith.langchain.com and paste your API key here.
# Setting these three vars auto-traces ALL LangChain and LangGraph calls.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=ai-doc
